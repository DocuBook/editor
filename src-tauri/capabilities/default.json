{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-app-ready-to-close",
    "allow-ask-ai",
    "allow-cancel-ai",
    "allow-close-vault",
    "allow-create-directory",
    "allow-create-file",
    "allow-create-vault",
    "allow-custom-ai-config",
    "allow-delete-api-key",
    "allow-delete-file",
    "allow-git-add-remote",
    "allow-git-branches",
    "allow-git-checkout",
    "allow-git-clone",
    "allow-git-commit",
    "allow-git-init",
    "allow-git-push-only",
    "allow-git-remove-remote",
    "allow-git-set-identity",
    "allow-git-settings",
    "allow-git-stage",
    "allow-git-status",
    "allow-health",
    "allow-list-api-keys",
    "allow-list-tree",
    "allow-markdown-preview",
    "allow-md-to-html",
    "allow-open-vault",
    "allow-read-file",
    "allow-read-file-binary",
    "allow-rename-file",
    "allow-search-vault",
    "allow-set-api-key",
    "allow-set-custom-endpoint",
    "allow-test-connection",
    "allow-list-models",
    "allow-wiki-backlinks",
    "allow-wiki-resolve",
    "allow-wiki-suggest",
    "allow-write-file",
    "opener:default",
    "core:window:allow-set-theme"
  ]
}
