# DocuBook — server environment variables
# All are optional (defaults shown). For Docker: copy to .env, or paste the
# values into Coolify → Environment Variables per deployment.

# ── Server (boot-time) ──────────────────────────────────────────────────────

# HTTP listen port. Keep 8080 when behind the Coolify/Traefik reverse proxy.
PORT=8080

# Where vaults/, keys.json and config.json live. Mount a persistent volume here.
DATA_DIR=/data

# Location of the built frontend (read-only). Change only if you mount your own build.
WWW_DIR=/app/www

# ── First-boot provisioning (headless admin) ─────────────────────────────────
# Set BOTH to auto-create the admin account and skip the setup wizard
# (like deploying with a known credential). Leave empty to use the in-app wizard.
# DB_ADMIN_EMAIL=admin@example.com
# DB_ADMIN_PASSWORD=change-me-123

# ── Login / sessions ─────────────────────────────────────────────────────────
# Env wins over the in-app overrides (Settings → System shows "from env" locked).

# Optional guard for PUBLIC deployments: whoever reaches the server before the
# owner sets up could claim the admin account. When set, the setup wizard
# requires this value.
#
# It is a PLAIN secret string (NOT a JWT, not signed/hashed) — compared
# verbatim against what the wizard submits. Any non-empty value works;
# generate a long random one, e.g.:
#   openssl rand -hex 32
# Leave empty for private/LAN installs (wizard works without a token).
DB_SETUP_TOKEN=

# "1" or "true" = open access without login (pre-web behavior).
DB_NO_AUTH=false

# Session lifetime in hours before re-login is required (valid 1–8760).
DB_SESSION_TTL_HOURS=168

# "1" or "true" = add the Secure flag to the session cookie.
# Enable when serving over HTTPS (Coolify TLS proxy).
DB_SECURE_COOKIE=false
