cd "$(dirname "$0")/.."

# Sync lockfiles to manifest versions — never bump *.lock by hand. Author
# bumps manifests (package.json, Cargo.toml, tauri.conf.json) + CHANGELOG;
# this hook regenerates the locks from them (fast, no compilation).
echo "🔄 Syncing lockfiles (package-lock.json, Cargo.lock ×2)..."
npm install --package-lock-only --ignore-scripts --no-audit --no-fund >/dev/null 2>&1
(cd src-tauri && cargo generate-lockfile >/dev/null 2>&1)
(cd server && cargo generate-lockfile >/dev/null 2>&1)

echo "🔄 Running TypeScript check..."
npx tsc -b
if [ $? -ne 0 ]; then
  echo "❌ TypeScript check failed. Fix errors before pushing."
  exit 1
fi

echo "🔄 Running Rust tests..."
(cd src-tauri && cargo test)
if [ $? -ne 0 ]; then
  echo "❌ Rust tests failed. Fix errors before pushing."
  exit 1
fi

echo "🔄 Running frontend tests..."
npx vitest run
if [ $? -ne 0 ]; then
  echo "❌ Frontend tests failed. Fix errors before pushing."
  exit 1
fi

echo "✅ All checks passed!"
